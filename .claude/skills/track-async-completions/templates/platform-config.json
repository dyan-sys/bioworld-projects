{
  "hireflix": {
    "gmail_search_query": "from:no-reply@hireflix.com subject:\"Interview Completed\"",
    "sender": "no-reply@hireflix.com",
    "subject_pattern": "^Interview Completed:\\s*(.+?)\\s+for\\s+(.+)$",
    "subject_groups": {
      "candidate_name": 1,
      "job_title": 2
    },
    "body_candidate_pattern": "<b>(.+?)</b>\\s+has completed the interview",
    "body_link_pattern": "https://admin\\.hireflix\\.com/jobs/[a-f0-9]+/interview/[a-f0-9]+",
    "tracking_link_prefix": "https://webhooks.hireflix.com/hook/tracking/click/",
    "interaction_type": "1st Round (Async)"
  }
}
