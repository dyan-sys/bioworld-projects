  "default": {
    "title": "Executive Partner (Default)",
    "rubric": "resume-scorer-v4.md",
    "rate_bounds": {
      "monthly": { "min": 790, "max": 1600 },
      "hourly": { "min": 4.5, "max": 9 }
    }
