{
  "description": "Maps Screener status values to R1 invite email templates and receipt prefixes",
  "round": "R1",
  "status_field": "Screener",
  "guard_field": "1R",
  "guard_value": "Not Started",
  "mappings": {
    "To Invite": {
      "label": "R1 Live Interview",
      "template": "R1-Live-Invite.md",
