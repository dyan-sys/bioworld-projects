{
  "hireflix": {
    "gmail_search_query": "from:no-reply@hireflix.com subject:\"Interview Completed\"",
    "sender": "no-reply@hireflix.com",
    "subject_pattern": "^Interview Completed:\\s*(.+?)\\s+for\\s+(.+)$",
    "subject_groups": {
      "candidate_name": 1,
      "job_title": 2
    },
    "body_candidate_pattern": "<b>(.+?)</b>\\s+has completed the interview",
    "body_link_pattern": "https://admin\\.hireflix\\.com/jobs/[a-f0-9]+/interview/[a-f0-9]+",
    "tracking_link_prefix": "https://webhooks.hireflix.com/hook/tracking/click/",
    "interaction_type": "1st Round (Async)",
    "candidate_pool_statuses": ["To invite (Async)", "To invite (Async Hireflix)"],
    "action": "create_interaction",
    "target_1r_status": "Async Done - Awaiting Review",
    "guard_1r_status": "Invitation Sent"
  },
  "hiretruffle": {
    "gmail_search_query": "from:hello@hiretruffle.com subject:\"completed screening\"",
    "sender": "hello@hiretruffle.com",
    "subject_pattern": "^New candidate completed screening for (.+)$",
    "subject_groups": {
      "job_title": 1
    },
    "body_candidate_pattern": "Name:\\s*([^<\\n]+)",
    "body_link_pattern": "https://app\\.hiretruffle\\.com/applications/[^\"\\s]+",
    "interaction_type": "1st Round (Async)",
    "candidate_pool_statuses": ["To invite (Async)", "To invite (Async Hireflix)"],
    "action": "create_interaction",
    "target_1r_status": "Async Done - Awaiting Review",
    "guard_1r_status": "Invitation Sent"
  },
  "calendly": {
    "gmail_search_query": "from:calendly.com subject:\"New Event\"",
    "sender": "notifications@calendly.com",
    "subject_pattern": "^New Event:\\s*(.+?)\\s+-\\s+\\d{2}:\\d{2}[ap]m\\b.+?-\\s+(.+)$",
    "subject_groups": {
      "candidate_name": 1,
      "job_title": 2
    },
    "body_candidate_pattern": "Invitee:\\s*</strong>\\s*<br[^>]*>\\s*([^<\\n]+)",
    "body_email_pattern": "mailto:([^\\s\"]+@[^\\s\"]+)",
    "body_link_pattern": "https://calendly\\.com/[^\"\\s]+",
    "candidate_pool_statuses": ["To Invite"],
    "action": "status_update_only",
    "target_1r_status": "Scheduled",
    "guard_1r_status": "Invitation Sent",
    "match_by_email": true
  }
}
