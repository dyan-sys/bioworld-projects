<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ally.resume-screener</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/yikfaiivanli/Projects/ally-os/scheduling/run-job.sh</string>
        <string>resume-screener</string>
        <string>.claude/skills/screen-resume/workflows/resume_screener_kimi.py</string>
        <string>--limit</string>
        <string>20</string>
    </array>

    <!-- Four times daily: 8am, noon, 4pm, 8pm SGT (launchd uses local time) -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>8</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>12</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>16</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>20</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/yikfaiivanli/Projects/ally-os/local-data/logs/launchd-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/yikfaiivanli/Projects/ally-os/local-data/logs/launchd-stderr.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/yikfaiivanli/Projects/ally-os</string>
</dict>
</plist>
